# ArcaneaClaw — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Google Gemini (classification + scoring)
GEMINI_API_KEY=your-gemini-api-key

# Vercel Blob (hero-tier uploads)
VERCEL_TOKEN=your-vercel-token
BLOB_READ_WRITE_TOKEN=your-blob-rw-token

# Notifications (optional)
NOTIFY_WEBHOOK_URL=https://your-webhook-url

# Config override (optional — defaults to /app/config.yaml)
# ARCANEA_CLAW_CONFIG=/app/config.yaml
