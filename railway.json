{
  "$schema": "https://railway.com/schema/v1.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python engine/daemon.py",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  },
  "environments": {
    "production": {
      "variables": {
        "SUPABASE_URL": {
          "description": "Your Supabase project URL",
          "required": true
        },
        "SUPABASE_SERVICE_KEY": {
          "description": "Supabase service role key (from Settings > API)",
          "required": true
        },
        "GEMINI_API_KEY": {
          "description": "Google Gemini API key for AI classification + scoring",
          "required": true
        },
        "VERCEL_TOKEN": {
          "description": "Vercel API token for hero image deployment",
          "required": false
        },
        "BLOB_READ_WRITE_TOKEN": {
          "description": "Vercel Blob read/write token",
          "required": false
        },
        "NOTIFY_WEBHOOK_URL": {
          "description": "Discord/Slack webhook for pipeline notifications",
          "required": false
        },
        "PIPELINE_INTERVAL": {
          "description": "Seconds between pipeline runs (default: 900)",
          "required": false,
          "default": "900"
        },
        "HEARTBEAT_INTERVAL": {
          "description": "Seconds between heartbeats (default: 300)",
          "required": false,
          "default": "300"
        }
      }
    }
  }
}
